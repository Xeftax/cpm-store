# Managed by dockyard — edit upstream, not here, except inside a keep region you open.
#
# Rendered from exclude.toml's [groups] table by `dockyard sync`, one heading per
# group: edit a group there, not a pattern here. What a project alone needs ignored goes
# in a `dockyard:keep` region of its own, which survives every sync.
#
# One group here is load-bearing beyond its own file. .gitleaks.toml allowlists
# `.claude/worktrees/`, and that is only safe because this file ignores the same path: a
# committable worktree would let the allowlist hide a real secret from the CI scan. Both
# come from the one `local-state` group, so the coupling is structural rather than a
# sentence someone has to remember.

# venvs
.venv/
venv/
.direnv/
.pyenv/

# venv-aliases
env/

# tox-envs
.tox/

# caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/

# python-bytecode
*.pyc
*.pyo
*.pyd

# build-artefacts
dist/
build/
_build/
*.egg-info/
.eggs/
__pypackages__/
buck-out/
site-packages/

# build-outputs
target/

# node-modules
node_modules/

