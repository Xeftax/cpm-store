_source/
trivy-reports/

# os-noise
# dockyard:keep:start oma-specs-not-redistributable
# OMA spec documents are (c) Open Mobile Alliance — internal/educational use only,
# redistribution requires written OMA permission. Never commit the PDFs, their
# markdown conversions, extracted images, or annex-derived test fixtures.
# Fetch them locally with: python3 tools/specs_fetch.py --convert --qa
# (see docs/specs/README.md, section "Publication")
docs/specs/pdf/
docs/specs/OMA-*.md
docs/specs/*_artifacts/
# dockyard:keep:end oma-specs-not-redistributable
.DS_Store
Thumbs.db
._*

# local-state
*.pem
*.key
credentials.json
.env
*.env.local
.claude/settings.local.json
.claude/.last-stop-marker
.claude/worktrees/
.serena/

# dockyard:keep:start vibe-local-state
# Vibe CLI session worktrees (vibe:worktree skill) - local state, never committed.
# Also covered locally by .git/info/exclude; this entry makes it durable across clones.
.vibe/worktrees/
# dockyard:keep:end vibe-local-state
